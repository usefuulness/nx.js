{
  "name": "nx.js",
  "private": true,
  "version": "0.1.0",
  "description": "Declarative, zero-dependency web components with an ExtJS-style config API and a shadcn-style look.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "require": "./dist/jsx-dev-runtime.cjs"
    },
    "./umd": "./dist/nx.umd.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode umd",
    "build:demo": "vite build --mode demo",
    "preview": "vite build --mode demo && vite preview --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/jest-dom": "^6.1.0",
    "@types/node": "^24.0.7",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.0.0"
  },
  "unpkg": "./dist/nx.umd.js"
}
